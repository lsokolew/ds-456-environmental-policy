journal_counts <- citations %>% count(journal) %>%
arrange(desc(n)) %>% filter(!is.na(journal), n>1)
color_cat <- mutate(journal_counts, color = case_when(n>10 ~ '#377E80',
n>3 ~ '#78B1B2',
TRUE ~ '#63666A')) %>% pull(color)
#'#2B6464' 1D4A4A 78B1B2 BAD7D7
# bad color issue; alignment
# pdf("Figures/wordcloud.pdf", width = 20, height = 16)  # true vector output
# wcld <- wordcloud(words = journal_counts$journal,
#           freq = journal_counts$n,
#           scale = c(4, 0.5),
#           colors = color_cat)
# dev.off()
#
# bad resolution
wcld <-   wordcloud2(journal_counts, color = color_cat, size = .5, fontWeight = 'normal')
saveWidget(wcld,"Figures/tmp.html",selfcontained = F)
webshot("Figures/tmp.html","Figures/wordcloud.png", delay =5, vwidth = 2000, vheight = 1500)
