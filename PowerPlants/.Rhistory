fill = '#78B1B2',
colour = "#377E80",
pattern_fill = "#377E80",
pattern_colour = '#2B6464',
pattern_density = 0.15,
pattern_spacing = 0.06,
pattern_angle = 45,
pattern_key_scale_factor = 0.6
) +
scale_pattern_manual(values = pattern_types) +
coord_flip() +
