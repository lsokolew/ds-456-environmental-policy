Wb <- nb2listw(Queen, style = "B",zero.policy = TRUE) #style = 'B' gives binary weights
spdep::moran.test(corn_info_per_county_model$log_resid, Wb, alternative = "two.sided", randomisation = TRUE)# Using randomization test
spdep::moran.test(corn_info_per_county_model$lm_resid, Wb, alternative = "two.sided", randomisation = TRUE)# Using randomization test
# Fit SAR Model spatial error
mod_sar <- spautolm(formula = `Yield per acre (bushels)` ~ average_summer_temp + Farmsnumber + `Area planted (acres)` ,
data = corn_info_per_county_model, listw = Ww, family = "SAR")
# Convert Neighborhood Information to List (with weighting so that rows sum to
# 1)
Ww <- nb2listw(Queen , style = "W", zero.policy=TRUE)
# Fit SAR Model spatial error
mod_sar <- spautolm(formula = `Yield per acre (bushels)` ~ average_summer_temp + Farmsnumber + `Area planted (acres)` ,
data = corn_info_per_county_model, listw = Ww, family = "SAR")
summary(mod_sar)
# BIC Score
BIC(mod_sar)
corn_info_per_county_model$sar_resid <- resid(mod_sar)
corn_info_per_county %>% ggplot() + geom_sf(color = 'grey',fill = 'grey')+
geom_sf(data = corn_info_per_county_model, aes(fill = sar_resid)) +
scale_fill_gradient2(mid = "white", high = "red", low = "blue") + theme_classic()
# Moran's I Test
spdep::moran.test(corn_info_per_county_model$sar_resid, Wb, alternative = "two.sided", randomisation = TRUE)  # Using randomization test
# Fit CAR Model
mod_car <- spautolm(formula = `Yield per acre (bushels)` ~ average_summer_temp + Farmsnumber + `Area planted (acres)` ,
data = corn_info_per_county_model, listw = Ww, family = "CAR")
summary(mod_car)
# BIC Score
BIC(mod_car)
corn_info_per_county_model$car_resid <- resid(mod_car)
corn_info_per_county %>% ggplot() + geom_sf(color = 'grey',fill = 'grey')+
geom_sf(data = corn_info_per_county_model, aes(fill = car_resid)) +
scale_fill_gradient2(mid = "white", high = "red", low = "blue") + theme_classic()
spdep::moran.test(corn_info_per_county_model$car_resid, Wb, alternative = "two.sided", randomisation = TRUE)  # Using randomization test
